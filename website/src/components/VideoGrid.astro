---
// A rollout comparison, laid out the way the supplementary video presents it:
// one row per policy, one column per sensor condition.
interface Props {
  condition: string;
  note: string;
  speed?: string;
  baselineFull: string;
  baselineCorrupted: string;
  egrFull: string;
  egrCorrupted: string;
}

const {
  condition,
  note,
  speed,
  baselineFull,
  baselineCorrupted,
  egrFull,
  egrCorrupted,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const prefix = base.endsWith("/") ? base : base + "/";
const url = (name: string) => `${prefix}videos/${name}`;

const rows = [
  { label: "vanilla π₀.₅", accent: false, full: baselineFull, corrupted: baselineCorrupted },
  { label: "EGR (ours)", accent: true, full: egrFull, corrupted: egrCorrupted },
];
---

<div class="not-prose my-6 flex flex-col gap-5">
  <p class="text-muted-foreground text-center text-base">
    {note}{speed && <span class="ml-2 opacity-70">({speed})</span>}
  </p>

  {
    rows.map((row) => (
      <div
        class:list={[
          "rounded-xl border p-3 sm:p-4",
          row.accent
            ? "border-primary/40 bg-primary/5"
            : "border-border bg-muted/60",
        ]}
      >
        <div
          class:list={[
            "mb-3 text-center text-lg font-medium",
            row.accent ? "text-primary" : "text-muted-foreground",
          ]}
        >
          {row.label}
        </div>
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 sm:gap-4">
          {[
            { tag: "Full sensors", src: row.full },
            { tag: condition, src: row.corrupted },
          ].map((cell) => (
            <figure class="m-0 flex flex-col gap-1.5">
              <video
                class="aspect-[4/3] w-full rounded-lg bg-black object-cover"
                src={url(cell.src)}
                autoplay
                loop
                muted
                playsinline
                preload="metadata"
              />
              <figcaption class="text-muted-foreground text-center text-sm">
                {cell.tag}
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    ))
  }
</div>
